# VINAXO Environment Variables Example
# Lưu ý: Cấu hình các biến này trên Vercel Project Settings > Environment Variables
# KHÔNG thêm tiền tố VITE_ cho các secret này để tránh lộ ra frontend bundle.

# GitHub OAuth Application Credentials for Decap CMS
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# Optional: OAuth Redirect Callback URL (mặc định tự động nhận diện theo domain)
# OAUTH_REDIRECT_URL=https://vinaxo.net/api/callback

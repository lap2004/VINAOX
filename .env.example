# VINAXO Environment Variables Example
# Lưu ý: Cấu hình các biến này trên Vercel Project Settings > Environment Variables
# KHÔNG thêm tiền tố VITE_ cho các secret này để tránh lộ ra frontend bundle.

# 1. VINAXO Custom Admin Credentials
# Tên đăng nhập quản trị (Mặc định: admin)
ADMIN_USERNAME=admin

# Chuỗi hash mật khẩu (scrypt:N:r:p:salt:hash)
# Chạy lệnh: node scripts/generate-password-hash.mjs <mat_khau_cua_ban> để tạo chuỗi này
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:example_salt:example_hash

# Khóa bí mật dùng ký HMAC phiên đăng nhập HttpOnly cookie (Tối thiểu 32 bytes)
# Chạy lệnh: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_byte_random_hex_secret_here

# 2. GitHub Backend Integration
# Personal Access Token (Classic hoặc Fine-grained) hoặc GitHub App Token
# Token này chỉ chạy phía Serverless Function (Vercel) để commit bài viết/hình ảnh vào GitHub repository.
# Tuyệt đối không để lộ token này ra frontend.
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Tên repository (Mặc định: lap2004/VINAOX)
GITHUB_REPO=lap2004/VINAOX

# Nhánh lưu trữ nội dung Production (Bắt buộc đặt là main cho môi trường Production; Preview tự động dùng nhánh preview hiện tại)
GITHUB_BRANCH=main

# 3. B2B Contact & Quotation Email Delivery (POST /api/contact & /api/inquiry)
# Chọn một nhà cung cấp transactional email (Khuyến nghị Resend hoặc Brevo) và cấu hình trên Vercel:
RESEND_API_KEY=
# Hoặc dùng Brevo transactional API:
BREVO_API_KEY=
# Địa chỉ gửi đã xác thực domain (hoặc onboarding@resend.dev khi test với Resend)
CONTACT_FROM_EMAIL=VINAXO B2B Portal <onboarding@resend.dev>
# Email nội bộ VINAXO nhận yêu cầu liên hệ & báo giá (server-only, client không thể ghi đè)
CONTACT_TO_EMAIL=cuonghoang0710@gmail.com
# Tùy chọn tương thích ngược / Webhook CRM / Google Apps Script nhận thông báo song song:
INQUIRY_WEBHOOK_URL=
# Tùy chọn bảo vệ chống bot nâng cao (nếu kích hoạt Cloudflare Turnstile):
TURNSTILE_SECRET_KEY=
